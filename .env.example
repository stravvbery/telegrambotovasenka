# Telegram Bot Ovasenka — environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` — it is git-ignored on purpose.

# --- Required ---

# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Fireworks AI API key (https://fireworks.ai) — powers DeepSeek / Kimi / GLM / Qwen
FIREWORKS_API_KEY=

# Google Gemini API keys (https://aistudio.google.com/apikey)
# Comma-separated. Multiple keys enable automatic rotation on rate limits.
GEMINI_API_KEYS=key1,key2,key3

# --- Optional: internet search ---

# Tavily search API key (https://tavily.com) — primary search backend
TAVILY_API_KEY=

# SerpAPI key (https://serpapi.com) — search fallback if Tavily fails
SERPAPI_KEY=

# Firecrawl API key (https://firecrawl.dev) — URL scraping
FIRECRAWL_API_KEY=

# --- Optional: behavior ---

# Default model id used for new users, group replies, and inline queries.
# One of: deepseek-v4, kimi-k2.6, glm-5.1, qwen-3.6-plus, gemini-flash
DEFAULT_MODEL=gemini-flash
